<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LLMTrace 审计报告 - {{ report_id }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; color: #1a1a1a; background: #fff; line-height: 1.6; max-width: 960px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 1.5em; margin-bottom: 8px; }
  h2 { font-size: 1.2em; margin-top: 24px; margin-bottom: 12px; border-bottom: 2px solid #e5e5e5; padding-bottom: 4px; }
  h3 { font-size: 1.05em; margin-top: 16px; margin-bottom: 8px; }
  .meta { color: #666; font-size: 0.9em; margin-bottom: 16px; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 16px; }
  th, td { border: 1px solid #e5e5e5; padding: 8px 12px; text-align: left; font-size: 0.9em; }
  th { background: #f5f5f5; font-weight: 600; }
  .risk-high { color: #d32f2f; font-weight: bold; }
  .risk-medium { color: #f57c00; font-weight: bold; }
  .risk-low { color: #388e3c; font-weight: bold; }
  .risk-inconclusive { color: #757575; }
  .status-pass { color: #388e3c; }
  .status-fail { color: #d32f2f; }
  .status-warn { color: #f57c00; }
  .finding { border: 1px solid #e5e5e5; border-radius: 4px; padding: 12px; margin-bottom: 12px; }
  .finding h3 { margin-top: 0; }
  .facts, .inferences, .limitations { margin: 8px 0; }
  .facts li, .inferences li, .limitations li { font-size: 0.9em; }
  .evidence-item { border: 1px solid #e5e5e5; border-radius: 4px; padding: 12px; margin-bottom: 12px; }
  .evidence-item summary { cursor: pointer; font-weight: 600; }
  .evidence-item pre { background: #f5f5f5; padding: 8px; overflow-x: auto; font-size: 0.8em; margin-top: 8px; white-space: pre-wrap; word-break: break-all; }
  .disclaimer { background: #fff3e0; border: 1px solid #ffe0b2; border-radius: 4px; padding: 12px; margin-top: 24px; font-size: 0.9em; }
  .disclaimer h3 { color: #e65100; }
</style>
</head>
<body>

<h1>LLMTrace 审计报告</h1>
<div class="meta">
  <p>报告 ID: {{ report_id }}</p>
  <p>生成时间: {{ utc_time }}</p>
  <p>LLMTrace 版本: {{ llmtrace_version }}</p>
  <p>Python: {{ python_version }} | {{ platform }}</p>
</div>

<h2>1. 被测接口摘要</h2>
<table>
  <tr><th>项目</th><th>值</th></tr>
  <tr><td>Endpoint</td><td>{{ config.base_url }}</td></tr>
  <tr><td>协议</td><td>{{ config.protocol }}</td></tr>
  <tr><td>声称模型</td><td>{{ config.model }}</td></tr>
  <tr><td>重复次数</td><td>{{ config.repeat_count }}</td></tr>
  <tr><td>超时</td><td>{{ config.timeout }}s</td></tr>
  <tr><td>最大输出 Token</td><td>{{ config.max_output_tokens }}</td></tr>
</table>

<h2>2. 风险结论</h2>
<p class="risk-{{ risk_level | lower }}"><strong>风险等级: {{ risk_level }}</strong></p>
<p>{{ risk_explanation }}</p>

<h2>3. 探针结果</h2>
{% for finding in findings %}
<div class="finding">
  <h3>{{ finding.probe_name }} <span class="status-{{ finding.status }}">[{{ finding.status }}]</span> <span>({{ finding.severity }})</span></h3>
  {% if finding.facts %}
  <div class="facts">
    <strong>客观事实:</strong>
    <ul>
      {% for fact in finding.facts %}<li>{{ fact }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if finding.inferences %}
  <div class="inferences">
    <strong>推断:</strong>
    <ul>
      {% for inf in finding.inferences %}<li>{{ inf }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if finding.limitations %}
  <div class="limitations">
    <strong>局限说明:</strong>
    <ul>
      {% for lim in finding.limitations %}<li>{{ lim }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
{% endfor %}

<h2>4. 调用时间线</h2>
<table>
  <tr><th>#</th><th>请求模型</th><th>返回模型</th><th>HTTP</th><th>延迟(ms)</th><th>成功</th></tr>
  {% for ev in evidence %}
  <tr>
    <td>{{ loop.index }}</td>
    <td>{{ ev.request_model or 'N/A' }}</td>
    <td>{{ ev.response_model or 'N/A' }}</td>
    <td>{{ ev.http_status or 'N/A' }}</td>
    <td>{{ "%.0f"|format(ev.total_latency_ms) if ev.total_latency_ms else 'N/A' }}</td>
    <td>{{ '是' if ev.success else '否' }}</td>
  </tr>
  {% endfor %}
</table>

<h2>5. 元数据一致性</h2>
<table>
  <tr><th>指标</th><th>值</th></tr>
  <tr><td>返回模型集合</td><td>{{ response_models | join(', ') if response_models else '无' }}</td></tr>
  <tr><td>响应结构指纹</td><td>{{ fingerprints | join(', ') if fingerprints else '无' }}</td></tr>
  <tr><td>Token 字段存在率</td><td>{{ token_rate }}</td></tr>
  <tr><td>请求 ID 存在率</td><td>{{ rid_rate }}</td></tr>
</table>

<h2>6. 原始证据摘要</h2>
{% for ev in evidence %}
<details class="evidence-item">
  <summary>请求 #{{ loop.index }}: {{ ev.request_method }} {{ ev.request_path }} ({{ ev.http_status }})</summary>
  <pre>{{ ev | tojson(indent=2) }}</pre>
</details>
{% endfor %}

{% if benchmarks %}
<h2>7. 能力评测</h2>
{% for bm in benchmarks %}
  <div class="benchmark-section">
    <h3>{{ bm.suite_id }} {{ bm.suite_version }}</h3>
    <div class="meta">
      <p>Source: {{ bm.source_id }} / {{ bm.source_revision }}</p>
      <p>Adapter: {{ bm.adapter_id }} {{ bm.adapter_version }}</p>
      <p>Started: {{ bm.started_at_display }} | Finished: {{ bm.finished_at_display }}</p>
    </div>
    <table>
      <tr><th>项目</th><th>值</th></tr>
      <tr><td>Status</td><td class="{{ bm.status_class }}">[{{ bm.status }}]</td></tr>
      <tr><td>Planned Requests</td><td>{{ bm.planned_requests }}</td></tr>
      <tr><td>Maximum Requests</td><td>{{ bm.maximum_requests }}</td></tr>
      <tr><td>Actual Requests</td><td>{{ bm.actual_requests }}</td></tr>
      <tr><td>Estimated Cost</td><td>{{ bm.estimated_cost_display }}</td></tr>
    </table>

    <h4>Tasks</h4>
    <table>
      <tr><th>Task ID</th><th>Status</th><th>Grader</th><th>Raw Score</th><th>Normalized Score</th><th>Evidence</th><th>Failure</th></tr>
      {% for task in bm.tasks %}
      <tr>
        <td>{{ task.task_id }}{% if task.is_smoke %} <span style="color:#757575;">(smoke)</span>{% endif %}</td>
        <td class="{{ task.status_class }}">{{ task.status }}</td>
        <td>{{ task.grader_id or 'N/A' }}</td>
        <td>{{ task.raw_score_display }}</td>
        <td>{{ task.normalized_score_display }}</td>
        <td><span title="{{ task.evidence_refs_display }}">{{ task.evidence_refs | length }}</span></td>
        <td>{{ task.failure_display or '—' }}</td>
      </tr>
      {% if task["items"] %}
      <tr>
        <td colspan="7" style="padding:0;">
          <details style="margin:4px 12px;">
            <summary>Items ({{ task["items"] | length }})</summary>
            <table style="margin:4px 0; font-size:0.85em;">
              <tr><th>Item</th><th>Status</th><th>Score</th><th>Evidence</th><th>{{ "Error / Failure" }}</th></tr>
              {% for item in task["items"] %}
              <tr>
                <td>{{ item.item_id }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.normalized_score if item.normalized_score is not none else '—' }}</td>
                <td>{{ item.evidence_refs | join(', ') if item.evidence_refs else '—' }}</td>
                <td>
                  {% if item.error_message %}
                    {{ item.error_message }}
                  {% elif item.failure_message %}
                    [{{ item.failure_category }}] {{ item.failure_error_code }}: {{ item.failure_message }}
                  {% else %}
                    —
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </table>
          </details>
        </td>
      </tr>
      {% endif %}
      {% endfor %}
    </table>

    <div class="disclaimer" style="margin-top:8px;">
      <strong>注意：</strong>本能力评测基于受控测试执行，不构成模型身份结论或模型排名。综合能力分数尚未计算。
      {% if bm.warnings %}
      <br><strong>Warnings:</strong> {{ bm.warnings | join('; ') }}
      {% endif %}
    </div>
    {% for task in bm.tasks %}
      {% if task.is_smoke %}
      <p style="font-size:0.85em;color:#757575;">适配器集成验证，不计入正式能力评分</p>
      {% endif %}
    {% endfor %}
  </div>
{% endfor %}
{% endif %}

{% if reference_comparison %}
<h2>{{ (7 if benchmarks else 6) + 1 }}. Reference Comparison</h2>
<div class="meta">
  <p>Reference Snapshot: {{ reference_comparison.reference_snapshot }}</p>
  <p>Suite: {{ reference_comparison.suite_id }} {{ reference_comparison.suite_version }}</p>
  <p>Reference (label): {{ reference_comparison.model_a }} | Candidate (label): {{ reference_comparison.model_b }}</p>
</div>
<table>
  <tr><th>Dimension</th><th>Reference</th><th>Candidate</th><th>Delta</th></tr>
  {% for d in reference_comparison.dimension_diffs %}
  <tr>
    <td>{{ d.dimension }}</td>
    <td>{{ "%.4f"|format(d.reference) }}</td>
    <td>{{ "%.4f"|format(d.candidate) }}</td>
    <td>{{ "%+.4f"|format(d.delta) }}</td>
  </tr>
  {% endfor %}
</table>
<div class="disclaimer">
  <strong>UNCALIBRATED：</strong>Reference Comparison 不是 Calibration。差异仅表示候选在各维度相对参考画像的高低，不构成模型身份结论，也不是 0–100 正式评分。
</div>
{% endif %}

{% if capability_profile %}
<h2>{{ (7 if benchmarks else 6) + (1 if reference_comparison else 0) + 1 }}. Capability Profile</h2>
{% if capability_profile.calibrated_total_score is not none %}
<div class="meta">
  <p><strong>Capability Score: {{ "%.1f"|format(capability_profile.calibrated_total_score) }} / 100</strong>
    （{{ capability_profile.calibration_status }}）</p>
</div>
{% endif %}
<div class="meta">
  <p>Profile: {{ capability_profile.profile_version }} | Policy: {{ capability_profile.scoring_policy_id }} {{ capability_profile.scoring_policy_version }}</p>
  <p>Coverage: {{ "%.2f"|format(capability_profile.coverage_weight) }} | Provisional Raw Index: {{ "%.4f"|format(capability_profile.provisional_raw_index) }}</p>
  {% if capability_profile.calibration %}
  <p>Calibration: {{ capability_profile.calibration.policy_id }} {{ capability_profile.calibration.policy_version }}
    | Reference Set: {{ capability_profile.calibration.reference_set_id }} {{ capability_profile.calibration.reference_set_version }}
    | Reference Identities: {{ capability_profile.calibration.reference_identity_count }}</p>
  {% endif %}
</div>
<table>
  <tr><th>Dimension</th><th>Status</th><th>Raw Score</th><th>Calibrated</th><th>Coverage</th><th>Weight</th></tr>
  {% for d in capability_profile.dimensions %}
  <tr>
    <td>{{ d.dimension }}</td>
    <td>{{ d.status }}</td>
    <td>{{ "%.4f"|format(d.raw_score) }}</td>
    <td>{% if d.calibrated_score is not none %}{{ "%.1f"|format(d.calibrated_score) }}{% else %}N/A{% endif %}</td>
    <td>{{ "%.2f"|format(d.task_coverage) }}</td>
    <td>{{ "%.2f"|format(d.global_weight) }}</td>
  </tr>
  {% endfor %}
</table>
{% if capability_profile.calibration %}
<div class="disclaimer">
  <strong>CALIBRATED：</strong>以上 calibrated 分数是在当前 Suite、Scoring Policy 和 ReferenceSet 定义的 LLMTrace calibration universe 中的版本化能力分（0–100），不是绝对世界排名。Raw 分数继续保留供审计。
</div>
{% else %}
<div class="disclaimer">
  <strong>UNCALIBRATED：</strong>以上是 raw / provisional / uncalibrated 分数，不是 0–100 正式能力分。Provisional Raw Index 不是百分制评分，0.75 不代表 75/100。
</div>
{% endif %}
{% endif %}

{% if claimed_model_gap %}
<h2>{{ (7 if benchmarks else 6) + (1 if reference_comparison else 0) + (1 if capability_profile else 0) + 1 }}. Claimed Model Comparison</h2>
<div class="meta">
  <p>Claimed Model: <strong>{{ claimed_model_gap.claimed_model_id }}</strong></p>
  <p>Trusted Reference: {{ "%.1f"|format(claimed_model_gap.reference_total_score) }} / 100
    （{{ claimed_model_gap.reference_provider_id }} / {{ claimed_model_gap.reference_model_id }}）</p>
  <p>Measured Capability: {{ "%.1f"|format(claimed_model_gap.candidate_total_score) }} / 100 |
    <strong>Capability Gap: {{ "%+.1f"|format(claimed_model_gap.total_delta) }}</strong></p>
</div>
<table>
  <tr><th>Dimension</th><th>Measured</th><th>Reference</th><th>Gap</th></tr>
  {% for dg in claimed_model_gap.dimension_gaps %}
  <tr>
    <td>{{ dg.dimension }}</td>
    <td>{{ "%.1f"|format(dg.candidate_score) }}</td>
    <td>{{ "%.1f"|format(dg.reference_score) }}</td>
    <td>{{ "%+.1f"|format(dg.delta) }}</td>
  </tr>
  {% endfor %}
</table>
<div class="disclaimer">
  <strong>解读：</strong>被测端点的能力分与声明模型兼容的可信参考配置存在上述差距。这是能力比较（capability comparison），不是模型身份证明（not proof of upstream model identity）。
</div>
{% endif %}

{% if fingerprint_evidence %}
<h2>{{ (7 if benchmarks else 6) + (1 if reference_comparison else 0) + (1 if capability_profile else 0) + (1 if claimed_model_gap else 0) + 1 }}. Model Fingerprint Evidence (Experimental)</h2>
<div class="disclaimer">
  <strong>实验性：</strong>{{ fingerprint_evidence.disclaimer }}
</div>
<div class="meta">
  {% if fingerprint_evidence.suite %}
  <p>Fingerprint Suite: {{ fingerprint_evidence.suite.suite_id }} {{ fingerprint_evidence.suite.suite_version }}
    {% if fingerprint_evidence.suite.content_sha256 %}| content sha256: {{ fingerprint_evidence.suite.content_sha256 }}{% endif %}</p>
  {% endif %}
  {% if fingerprint_evidence.reference_set %}
  <p>Fingerprint Set: {{ fingerprint_evidence.reference_set.fingerprint_set_id }} {{ fingerprint_evidence.reference_set.fingerprint_set_version }}
    | members: {{ fingerprint_evidence.reference_set.member_count }}
    {% if fingerprint_evidence.reference_set.content_sha256 %}| content sha256: {{ fingerprint_evidence.reference_set.content_sha256 }}{% endif %}</p>
  {% else %}
  <p>Fingerprint Set: <strong>UNAVAILABLE</strong>（本次没有可用的参考集，因此只报告候选自身的行为观测）</p>
  {% endif %}
  {% if fingerprint_evidence.decision_policy %}
  <p>Decision Policy: {{ fingerprint_evidence.decision_policy.policy_id }} {{ fingerprint_evidence.decision_policy.policy_version }}
    | validated: {{ fingerprint_evidence.decision_policy.validated }}
    | min comparable probes: {{ fingerprint_evidence.decision_policy.minimum_comparable_probes }}
    | distance threshold: {{ "%.4f"|format(fingerprint_evidence.decision_policy.distance_threshold) }}</p>
  {% else %}
  <p>Decision Policy: <strong>UNAVAILABLE</strong>（本次没有通过 held-out validation 的 policy，因此不产生 verified identity verdict）</p>
  {% endif %}
  {% if fingerprint_evidence.repetitions is not none %}
  <p>Repetitions: {{ fingerprint_evidence.repetitions }}</p>
  {% endif %}
  {% if fingerprint_evidence.probe_coverage %}
  <p>Probe Coverage: {{ fingerprint_evidence.probe_coverage.compared_probes }} / {{ fingerprint_evidence.probe_coverage.total_probes }}
    ({{ "%.1f"|format(fingerprint_evidence.probe_coverage.ratio * 100) }}%)</p>
  {% endif %}
  {% if fingerprint_evidence.invalid_outcome_count is not none %}
  <p>Invalid Outcomes (candidate capture): {{ fingerprint_evidence.invalid_outcome_count }}</p>
  {% endif %}
</div>
<div class="meta">
  <p>Verdict: <strong>{{ fingerprint_evidence.verdict.match_status or "N/A" }}</strong>
    | claim verdict produced: {{ fingerprint_evidence.verdict.claim_verdict_produced }}
    | reference identities: {{ fingerprint_evidence.verdict.reference_identity_count }}</p>
  {% if fingerprint_evidence.claimed_model_id %}
  <p>Claimed Model: {{ fingerprint_evidence.claimed_model_id }}
    {% if fingerprint_evidence.claimed_reference_distance is not none %}| claimed reference distance: {{ "%.4f"|format(fingerprint_evidence.claimed_reference_distance) }}{% else %}| no capture for the claimed model in this fingerprint set{% endif %}</p>
  {% endif %}
</div>
{% if fingerprint_evidence.verdict.notes %}
<ul>
  {% for note in fingerprint_evidence.verdict.notes %}<li>{{ note }}</li>{% endfor %}
</ul>
{% endif %}
{% if fingerprint_evidence.jsd_reference %}
<div class="meta">
  <p>JSD Reference ({{ fingerprint_evidence.jsd_reference.basis }}):
    {{ fingerprint_evidence.jsd_reference.provider_id }} / {{ fingerprint_evidence.jsd_reference.model_id }}
    | comparable probes: {{ fingerprint_evidence.jsd_reference.comparable_probes }}
    {% if fingerprint_evidence.aggregate_jsd is not none %}| aggregate JSD: {{ "%.4f"|format(fingerprint_evidence.aggregate_jsd) }}{% endif %}</p>
</div>
<table>
  <tr><th>Probe</th><th>Weight</th><th>Comparable</th><th>JSD</th><th>Candidate Samples</th><th>Invalid</th><th>Note</th></tr>
  {% for probe in fingerprint_evidence.per_probe_jsd %}
  <tr>
    <td>{{ probe.probe_id }}</td>
    <td>{{ "%.2f"|format(probe.weight) }}</td>
    <td>{{ "yes" if probe.comparable else "no" }}</td>
    <td>{% if probe.distance is not none %}{{ "%.4f"|format(probe.distance) }}{% else %}N/A{% endif %}</td>
    <td>{% if probe.candidate_sample_count is not none %}{{ probe.candidate_sample_count }}{% else %}N/A{% endif %}</td>
    <td>{% if probe.candidate_invalid_count is not none %}{{ probe.candidate_invalid_count }}{% else %}N/A{% endif %}</td>
    <td>{{ probe.note or "" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if fingerprint_evidence.top_k %}
<h3>Behavioral Nearest References (Top-K)</h3>
<table>
  <tr><th>Rank</th><th>Provider</th><th>Model</th><th>Distance</th><th>Similarity</th><th>Comparable Probes</th></tr>
  {% for entry in fingerprint_evidence.top_k %}
  <tr>
    <td>{{ entry.rank }}</td>
    <td>{{ entry.provider_id }}</td>
    <td>{{ entry.model_id }}</td>
    <td>{{ "%.4f"|format(entry.distance) }}</td>
    <td>{{ "%.4f"|format(entry.similarity) }}</td>
    <td>{{ entry.comparable_probes }}</td>
  </tr>
  {% endfor %}
</table>
<div class="disclaimer">
  <strong>语义边界：</strong>Top-K 只是“行为分布最接近的参考”排序窗口，不是 Top-1 身份判定；排名第一不代表上游模型就是该参考。
</div>
{% endif %}
{% if fingerprint_evidence.routing %}
<h3>Routing Signals</h3>
<div class="meta">
  <p>Level: <strong>{{ fingerprint_evidence.routing.level }}</strong>
    | experimental: {{ fingerprint_evidence.routing.experimental }}
    | policy: {{ fingerprint_evidence.routing.policy_id }} {{ fingerprint_evidence.routing.policy_version }}</p>
  <p>Items: {{ fingerprint_evidence.routing.item_count }}
    | reported model coverage: {{ "%.2f"|format(fingerprint_evidence.routing.response_model_coverage) }}
    | distinct response models: {{ fingerprint_evidence.routing.distinct_response_models }}
    | dominant ratio: {% if fingerprint_evidence.routing.dominant_model_ratio is not none %}{{ "%.2f"|format(fingerprint_evidence.routing.dominant_model_ratio) }}{% else %}N/A{% endif %}
    | failure ratio: {{ "%.2f"|format(fingerprint_evidence.routing.failure_ratio) }}
    | temporal: {{ fingerprint_evidence.routing.temporal_status }}</p>
</div>
<table>
  <tr><th>Signal</th><th>Strength</th><th>Observed</th><th>Reason</th></tr>
  {% for signal in fingerprint_evidence.routing.signals %}
  <tr>
    <td>{{ signal.signal_id }}</td>
    <td>{{ signal.strength }}</td>
    <td>{{ "yes" if signal.observed else "no" }}</td>
    <td>{{ signal.reason }}</td>
  </tr>
  {% endfor %}
</table>
{% if fingerprint_evidence.routing.reasons %}
<ul>
  {% for reason in fingerprint_evidence.routing.reasons %}<li>{{ reason }}</li>{% endfor %}
</ul>
{% endif %}
{% if fingerprint_evidence.routing.limitations %}
<ul>
  {% for limitation in fingerprint_evidence.routing.limitations %}<li>{{ limitation }}</li>{% endfor %}
</ul>
{% endif %}
{% endif %}
{% if fingerprint_evidence.confidence %}
<h3>Confidence Bundle</h3>
<table>
  <tr><th>Component</th><th>Level</th><th>Reasons</th><th>Limitations</th></tr>
  {% for name, component in fingerprint_evidence.confidence.items() %}
  <tr>
    <td>{{ name }}</td>
    <td>{{ component.level }}</td>
    <td>{{ component.reasons | join('; ') }}</td>
    <td>{{ component.limitations | join('; ') }}</td>
  </tr>
  {% endfor %}
</table>
<div class="disclaimer">
  <strong>语义边界：</strong>四个组件各自独立，不合并成单一置信度数字；组件缺失时标记为 unavailable，不做推测。
</div>
{% endif %}
{% endif %}

{% if behavior_drift %}
<h2>{{ (7 if benchmarks else 6) + (1 if reference_comparison else 0) + (1 if capability_profile else 0) + (1 if claimed_model_gap else 0) + (1 if fingerprint_evidence else 0) + 1 }}. Behavior Drift</h2>
<div class="meta">
  <p>Overall Drift Level: <strong>{{ behavior_drift.drift_level }}</strong></p>
  <p>Baseline Run: {{ behavior_drift.baseline_run_id }} | Current Run: {{ behavior_drift.current_run_id }}</p>
  <p>Suite: {{ behavior_drift.suite_id }} {{ behavior_drift.suite_version }} | Policy: {{ behavior_drift.policy_id }} {{ behavior_drift.policy_version }}</p>
  <p>Target: {{ behavior_drift.target_id }} | Candidate: {{ behavior_drift.candidate_model_id }}</p>
</div>
<div class="meta">
  <p>
    Total Items: {{ behavior_drift.total_items }} |
    Graded Overlap: {{ behavior_drift.graded_overlap_count }} ({{ "%.1f"|format(behavior_drift.graded_overlap_ratio * 100) }}%) |
    Outcome Changed: {{ behavior_drift.outcome_changed_count }} |
    Status Changed: {{ behavior_drift.status_changed_count }} |
    Output Changed: {{ behavior_drift.output_changed_count }} |
    Response Model Changed: {{ behavior_drift.response_model_change_count }} |
    Finish Reason Changed: {{ behavior_drift.finish_reason_change_count }}
  </p>
</div>
<table>
  <tr><th>Dimension</th><th>Baseline</th><th>Current</th><th>Delta</th></tr>
  {% for d in behavior_drift.dimension_diffs %}
  <tr>
    <td>{{ d.dimension }}</td>
    <td>{{ "%.4f"|format(d.baseline) }}</td>
    <td>{{ "%.4f"|format(d.current) }}</td>
    <td>{{ "%+.4f"|format(d.delta) }}</td>
  </tr>
  {% endfor %}
</table>
<table>
  <tr><th>Task</th><th>Source Sample</th><th>Input SHA (short)</th><th>Before</th><th>After</th><th>Score Delta</th><th>Signals</th></tr>
  {% for item in behavior_drift.item_diffs %}
  <tr>
    <td>{{ item.task_id }}</td>
    <td>{{ item.source_sample_id }}</td>
    <td>{{ item.input_sha256_short }}</td>
    <td>{{ item.baseline_status }}</td>
    <td>{{ item.current_status }}</td>
    <td>{{ "%+.4f"|format(item.score_delta) }}</td>
    <td>{{ item.signals | join(', ') }}</td>
  </tr>
  {% endfor %}
</table>
<div class="disclaimer">
  <strong>语义边界：</strong>Behavior Drift 只描述“在相同测试条件下本次运行与历史运行观察到的行为变化”。输出文本变化不等于底层模型不同；能力结果变化也可能是 Provider 失败或可用性变化导致。本结果不构成模型身份结论。
</div>
{% endif %}

<h2>{{ (7 if benchmarks else 6) + (1 if reference_comparison else 0) + (1 if capability_profile else 0) + (1 if claimed_model_gap else 0) + (1 if fingerprint_evidence else 0) + (1 if behavior_drift else 0) + 1 }}. 限制和免责声明</h2>
<div class="disclaimer">
  <h3>重要限制</h3>
  <ul>
    <li>客户端无法看到中转站真实上游后台。</li>
    <li>model 和请求 ID 可以被中转站改写。</li>
    <li>无效模型被拒绝不代表实际模型真实。</li>
    <li>回答风格相似不等于模型身份相同。</li>
    <li>低风险不等于服务商已被证明可信。</li>
    <li>延迟受网络、负载、缓存和队列影响。</li>
    <li>模型别名可能造成名称不一致。</li>
    <li>行为指纹证据是实验性的：它只描述"行为分布最接近的参考"，不构成模型身份结论。</li>
  </ul>
  <p style="margin-top: 8px;"><strong>LLMTrace 不声称可以识别真实上游模型。本报告仅供审计参考，不构成法律或商业建议。</strong></p>
</div>

</body>
</html>